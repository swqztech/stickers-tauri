{

  "$schema": "https://schema.tauri.app/config/2",

  "productName": "贴纸板",

  "version": "1.0.0",

  "identifier": "com.codes.stickers.tauri",

  "build": {

    "beforeDevCommand": "npm run dev:serve",

    "devUrl": "http://localhost:5186",

    "beforeBuildCommand": "npm run build:api && npm run build",

    "frontendDist": "../dist"

  },

  "app": {

    "windows": [

      {

        "title": "贴纸板",

        "width": 1100,

        "height": 760,

        "minWidth": 720,

        "minHeight": 520,

        "backgroundColor": "#2A3340"

      }

    ],

    "security": {

      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3923; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"

    }

  },

  "bundle": {

    "active": true,

    "targets": ["nsis"],

    "icon": ["icons/icon.png", "icons/icon.ico"],

    "resources": ["resources/stickers-api/**/*"]

  }

}


